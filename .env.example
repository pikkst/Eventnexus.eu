# Public site configuration
PUBLIC_SITE_URL=

# Supabase public configuration
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=yzsoczlghgcqitevamfo

# Resend webhook receiver secret
RESEND_WEBHOOK_SECRET=

# Resend email notification configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=

# Optional spam protection
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional abuse protection
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=60000

# Optional privacy-first analytics (Cloudflare Web Analytics beacon token)
PUBLIC_ANALYTICS_ID=
PUBLIC_ANALYTICS_ENABLED=true

# Retention periods (days)
RETENTION_LEAD_DAYS=1095
RETENTION_WEBHOOK_EVENT_DAYS=365
RETENTION_APP_LOG_DAYS=365

# Local development admin seed (only used by scripts/seed-local-admin.ts)
# Only set these when using a local Supabase instance.
# npm run seed:local-admin loads .env.test via DOTENV_CONFIG_PATH=.env.test
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=changeme
