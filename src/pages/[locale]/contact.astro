---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations, getAvailableLanguages } from '../../i18n';

export const getStaticPaths = () => {
  return getAvailableLanguages().map((locale) => ({ params: { locale } }));
};

const locale = Astro.params.locale || 'en';
const t = getTranslations(locale);

const stepOfText = (step: number, total: number) => {
  if (typeof t.common.stepOf === 'function') {
    return t.common.stepOf(step, total);
  }
  return `Step ${step} of ${total}`;
};

const initialStepText = stepOfText(1, 8);

const projectTypes = t.contact.options.projectTypes;
const featureOptions = t.contact.options.featureOptions;
const technicalNeeds = t.contact.options.technicalNeeds;
const timelineOptions = t.contact.options.timelineOptions;
const budgetOptions = t.contact.options.budgetOptions;
const statusOptions = t.contact.options.statusOptions;
const integrationOptions = t.contact.options.integrationOptions;

const translationsJson = JSON.stringify(t);
const turnstileSiteKey = process.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer
></script>

<BaseLayout
  title={t.contact.hero.headline}
  description={t.contact.hero.description1}
  locale={locale}
>
  <section class="bg-surface py-16 text-text md:py-24">
    <div class="container mx-auto max-w-4xl px-4">
      <div class="max-w-2xl">
        <h1
          class="text-4xl font-extrabold leading-tight tracking-tight text-text md:text-5xl"
        >
          {t.contact.hero.headline}
        </h1>

        <p class="mt-6 text-lg leading-relaxed text-text-muted">
          {t.contact.hero.description1}
        </p>

        <p class="mt-4 text-base leading-relaxed text-text-muted">
          {t.contact.hero.description2}
        </p>
      </div>

      <div class="mt-12 rounded-lg border border-border bg-surface shadow-sm">
        <div class="border-b border-border px-6 py-5">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold text-text">
              {t.contact.form.title}
            </h2>

            <span id="step-indicator" class="text-sm text-text-muted"
              >{initialStepText}</span
            >
          </div>

          <div class="mt-4 h-1 w-full rounded bg-surface-muted">
            <div
              id="progress-bar"
              class="h-1 rounded bg-primary transition-all duration-200"
              style="width: 12.5%;"
            >
            </div>
          </div>
        </div>

        <div
          id="form-error"
          class="hidden border-b border-border bg-red-50 px-6 py-5"
        >
          <p class="text-sm font-semibold text-red-800">
            {t.common.errorTitle}
          </p>
          <ul
            id="form-error-list"
            class="mt-2 list-inside list-disc text-sm text-red-700"
          >
          </ul>
        </div>

        <div
          id="contact-only-path"
          class="hidden border-b border-border bg-surface-muted px-6 py-5"
        >
          <p class="text-sm font-semibold text-text">
            {t.contact.form.contactOnly.label}
          </p>

          <p class="mt-1 text-sm text-text-muted">
            {t.contact.form.contactOnly.description}
          </p>
        </div>

        <form id="project-request-form" class="space-y-8 px-6 py-8" novalidate>
          <input
            type="hidden"
            name="website"
            id="website"
            tabindex="-1"
            autocomplete="off"
            style="display:none"
          />
          <input type="hidden" name="formLoadedAt" id="formLoadedAt" value="" />
          <input
            type="hidden"
            name="turnstileToken"
            id="turnstileToken"
            value=""
          />
          <!-- Step 1: Contact Identity -->

          <fieldset id="step-1" class="step">
            <legend class="text-base font-semibold text-text"
              >{t.contact.step1.legend}</legend
            >

            <p class="mt-1 text-sm text-text-muted">
              {t.contact.step1.description}
            </p>

            <div class="mt-6 grid gap-6 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label
                  for="fullName"
                  class="block text-sm font-medium text-text"
                  >{t.contact.step1.fullName}
                  <span class="text-red-500">*</span></label
                >

                <input
                  id="fullName"
                  name="fullName"
                  type="text"
                  required
                  class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                  placeholder={t.contact.step1.fullNamePlaceholder}
                />
              </div>

              <div class="sm:col-span-2">
                <label for="email" class="block text-sm font-medium text-text"
                  >{t.contact.step1.email}
                  <span class="text-red-500">*</span></label
                >

                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                  placeholder={t.contact.step1.emailPlaceholder}
                />
              </div>

              <div>
                <label for="phone" class="block text-sm font-medium text-text"
                  >{t.contact.step1.phone}</label
                >

                <input
                  id="phone"
                  name="phone"
                  type="text"
                  class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                  placeholder={t.contact.step1.phonePlaceholder}
                />
              </div>

              <div>
                <label for="company" class="block text-sm font-medium text-text"
                  >{t.contact.step1.company}</label
                >

                <input
                  id="company"
                  name="company"
                  type="text"
                  class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                  placeholder={t.contact.step1.companyPlaceholder}
                />
              </div>

              <div class="sm:col-span-2">
                <label for="region" class="block text-sm font-medium text-text"
                  >{t.contact.step1.region}</label
                >

                <input
                  id="region"
                  name="region"
                  type="text"
                  class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                  placeholder={t.contact.step1.regionPlaceholder}
                />
              </div>
            </div>
          </fieldset>

          <!-- Step 2: Project Type -->

          <fieldset id="step-2" class="step hidden">
            <legend class="text-base font-semibold text-text"
              >{t.contact.step2.legend}</legend
            >

            <p class="mt-1 text-sm text-text-muted">
              {t.contact.step2.description}
            </p>

            <div class="mt-6 space-y-6">
              <div>
                <label
                  for="projectType"
                  class="block text-sm font-medium text-text"
                  >{t.contact.step2.projectType}
                  <span class="text-red-500">*</span></label
                >

                <select
                  id="projectType"
                  name="projectType"
                  required
                  class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                >
                  <option value="" disabled selected
                    >{t.contact.step2.projectTypePlaceholder}</option
                  >

                  {
                    projectTypes.map((type) => (
                      <option value={type.id}>{type.label}</option>
                    ))
                  }
                </select>
              </div>

              <div>
                <label
                  for="projectTitle"
                  class="block text-sm font-medium text-text"
                  >{t.contact.step2.projectTitle}
                  <span class="text-red-500">*</span></label
                >

                <input
                  id="projectTitle"
                  name="projectTitle"
                  type="text"
                  required
                  class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                  placeholder={t.contact.step2.projectTitlePlaceholder}
                />
              </div>
            </div>
          </fieldset>

          <!-- Step 3: Idea Description -->

          <fieldset id="step-3" class="step hidden">
            <legend class="text-base font-semibold text-text"
              >{t.contact.step3.legend}</legend
            >

            <p class="mt-1 text-sm text-text-muted">
              {t.contact.step3.description}
            </p>

            <div class="mt-6 space-y-6">
              <div>
                <label
                  for="ideaDescription"
                  class="block text-sm font-medium text-text"
                  >{t.contact.step3.whatBuild}
                  <span class="text-red-500">*</span></label
                >

                <textarea
                  id="ideaDescription"
                  name="ideaDescription"
                  rows="5"
                  required
                  minlength="80"
                  class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                  placeholder={t.contact.step3.whatBuildPlaceholder}></textarea>

                <p class="mt-1 text-xs text-text-muted">
                  {t.contact.step3.minLengthHint}
                </p>
              </div>

              <div>
                <label
                  for="targetUsers"
                  class="block text-sm font-medium text-text"
                  >{t.contact.step3.whoWillUse}</label
                >

                <input
                  id="targetUsers"
                  name="targetUsers"
                  type="text"
                  class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                  placeholder={t.contact.step3.whoWillUsePlaceholder}
                />
              </div>

              <div>
                <label
                  for="problemToSolve"
                  class="block text-sm font-medium text-text"
                  >{t.contact.step3.problemSolve}</label
                >

                <textarea
                  id="problemToSolve"
                  name="problemToSolve"
                  rows="3"
                  class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                  placeholder={t.contact.step3.problemSolvePlaceholder}
                ></textarea>
              </div>

              <div>
                <label
                  for="desiredOutcome"
                  class="block text-sm font-medium text-text"
                  >{t.contact.step3.desiredOutcome}</label
                >

                <textarea
                  id="desiredOutcome"
                  name="desiredOutcome"
                  rows="3"
                  class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                  placeholder={t.contact.step3.desiredOutcomePlaceholder}
                ></textarea>
              </div>
            </div>
          </fieldset>

          <!-- Step 4: Required Features -->

          <fieldset id="step-4" class="step hidden">
            <legend class="text-base font-semibold text-text"
              >{t.contact.step4.legend}</legend
            >

            <p class="mt-1 text-sm text-text-muted">
              {t.contact.step4.description}
            </p>

            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              {
                featureOptions.map((feature) => (
                  <label class="flex cursor-pointer items-start gap-3 rounded-md border border-border bg-surface p-3 hover:bg-surface-muted">
                    <input
                      type="checkbox"
                      name="features"
                      value={feature.id}
                      class="mt-1 h-4 w-4 rounded border-border text-primary focus:ring-ring"
                    />

                    <span class="text-sm text-text">{feature.label}</span>
                  </label>
                ))
              }
            </div>

            <div class="mt-6">
              <label
                for="extraFeatures"
                class="block text-sm font-medium text-text"
                >{t.contact.step4.importantFeatures}</label
              >

              <textarea
                id="extraFeatures"
                name="extraFeatures"
                rows="3"
                class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                placeholder={t.contact.step4.importantFeaturesPlaceholder}
              ></textarea>
            </div>
          </fieldset>

          <!-- Step 5: Technical Needs -->

          <fieldset id="step-5" class="step hidden">
            <legend class="text-base font-semibold text-text"
              >{t.contact.step5.legend}</legend
            >

            <p class="mt-1 text-sm text-text-muted">
              {t.contact.step5.description}
            </p>

            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              {
                technicalNeeds.map((need) => (
                  <label class="flex cursor-pointer items-start gap-3 rounded-md border border-border bg-surface p-3 hover:bg-surface-muted">
                    <input
                      type="checkbox"
                      name="technicalNeeds"
                      value={need.id}
                      class="mt-1 h-4 w-4 rounded border-border text-primary focus:ring-ring"
                    />

                    <span class="text-sm text-text">{need.label}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- Step 6: Timeline And Budget -->

          <fieldset id="step-6" class="step hidden">
            <legend class="text-base font-semibold text-text"
              >{t.contact.step6.legend}</legend
            >

            <p class="mt-1 text-sm text-text-muted">
              {t.contact.step6.description}
            </p>

            <div class="mt-6 grid gap-6 sm:grid-cols-2">
              <div>
                <label
                  for="timeline"
                  class="block text-sm font-medium text-text"
                  >{t.contact.step6.timeline}
                  <span class="text-red-500">*</span></label
                >

                <select
                  id="timeline"
                  name="timeline"
                  required
                  class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                >
                  <option value="" disabled selected
                    >{t.contact.step6.timelinePlaceholder}</option
                  >

                  {
                    timelineOptions.map((option) => (
                      <option value={option.id}>{option.label}</option>
                    ))
                  }
                </select>
              </div>

              <div>
                <label
                  for="budgetRange"
                  class="block text-sm font-medium text-text"
                  >{t.contact.step6.budget}
                  <span class="text-red-500">*</span></label
                >

                <select
                  id="budgetRange"
                  name="budgetRange"
                  required
                  class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                >
                  <option value="" disabled selected
                    >{t.contact.step6.budgetPlaceholder}</option
                  >

                  {
                    budgetOptions.map((option) => (
                      <option value={option.id}>{option.label}</option>
                    ))
                  }
                </select>
              </div>

              <div class="sm:col-span-2">
                <label
                  for="projectStatus"
                  class="block text-sm font-medium text-text"
                  >{t.contact.step6.status}
                  <span class="text-red-500">*</span></label
                >

                <select
                  id="projectStatus"
                  name="projectStatus"
                  required
                  class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                >
                  <option value="" disabled selected
                    >{t.contact.step6.statusPlaceholder}</option
                  >

                  {
                    statusOptions.map((option) => (
                      <option value={option.id}>{option.label}</option>
                    ))
                  }
                </select>
              </div>
            </div>
          </fieldset>

          <!-- Step 7: Integrations And Existing Assets -->

          <fieldset id="step-7" class="step hidden">
            <legend class="text-base font-semibold text-text"
              >{t.contact.step7.legend}</legend
            >

            <p class="mt-1 text-sm text-text-muted">
              {t.contact.step7.description}
            </p>

            <div class="mt-6 space-y-6">
              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label
                    for="existingDomain"
                    class="block text-sm font-medium text-text"
                    >{t.contact.step7.existingDomain}</label
                  >

                  <input
                    id="existingDomain"
                    name="existingDomain"
                    type="text"
                    class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                    placeholder={t.contact.step7.existingDomainPlaceholder}
                  />
                </div>

                <div>
                  <label
                    for="existingUrl"
                    class="block text-sm font-medium text-text"
                    >{t.contact.step7.existingUrl}</label
                  >

                  <input
                    id="existingUrl"
                    name="existingUrl"
                    type="url"
                    class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                    placeholder={t.contact.step7.existingUrlPlaceholder}
                  />
                </div>

                <div>
                  <label
                    for="existingRepo"
                    class="block text-sm font-medium text-text"
                    >{t.contact.step7.existingRepo}</label
                  >

                  <input
                    id="existingRepo"
                    name="existingRepo"
                    type="url"
                    class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                    placeholder={t.contact.step7.existingRepoPlaceholder}
                  />
                </div>

                <div>
                  <label
                    for="existingBrandAssets"
                    class="block text-sm font-medium text-text"
                    >{t.contact.step7.existingBrandAssets}</label
                  >

                  <input
                    id="existingBrandAssets"
                    name="existingBrandAssets"
                    type="text"
                    class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
                    placeholder={t.contact.step7.existingBrandAssetsPlaceholder}
                  />
                </div>
              </div>

              <div>
                <p class="block text-sm font-medium text-text">
                  {t.contact.step7.servicesIntegrate}
                </p>

                <div class="mt-3 grid gap-3 sm:grid-cols-2">
                  {
                    integrationOptions.map((integration) => (
                      <label class="flex cursor-pointer items-start gap-3 rounded-md border border-border bg-surface p-3 hover:bg-surface-muted">
                        <input
                          type="checkbox"
                          name="integrations"
                          value={integration.id}
                          class="mt-1 h-4 w-4 rounded border-border text-primary focus:ring-ring"
                        />

                        <span class="text-sm text-text">
                          {integration.label}
                        </span>
                      </label>
                    ))
                  }
                </div>
              </div>
            </div>
          </fieldset>

          <!-- Step 8: Review And Submit -->

          <fieldset id="step-8" class="step hidden">
            <legend class="text-base font-semibold text-text"
              >{t.contact.step8.legend}</legend
            >

            <p class="mt-1 text-sm text-text-muted">
              {t.contact.step8.description}
            </p>

            <div id="review-summary" class="mt-6 space-y-6">
              <div class="rounded-md border border-border bg-surface-muted p-5">
                <p
                  class="text-xs font-semibold uppercase tracking-widest text-slate-500"
                >
                  {t.contact.step8.contactLabel}
                </p>

                <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-2"></dl>
              </div>

              <div class="rounded-md border border-border bg-surface-muted p-5">
                <p
                  class="text-xs font-semibold uppercase tracking-widest text-slate-500"
                >
                  {t.contact.step8.projectLabel}
                </p>

                <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-2"></dl>
              </div>

              <div class="rounded-md border border-border bg-surface-muted p-5">
                <p
                  class="text-xs font-semibold uppercase tracking-widest text-slate-500"
                >
                  {t.contact.step8.ideaLabel}
                </p>

                <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-2"></dl>
              </div>

              <div class="rounded-md border border-border bg-surface-muted p-5">
                <p
                  class="text-xs font-semibold uppercase tracking-widest text-slate-500"
                >
                  {t.contact.step8.needsLabel}
                </p>

                <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-2"></dl>
              </div>

              <div class="rounded-md border border-border bg-surface-muted p-5">
                <p
                  class="text-xs font-semibold uppercase tracking-widest text-slate-500"
                >
                  {t.contact.step8.integrationsLabel}
                </p>

                <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-2"></dl>
              </div>
            </div>

            <div class="mt-6 flex items-start gap-3">
              <input
                id="consent"
                name="consent"
                type="checkbox"
                required
                class="mt-1 h-4 w-4 rounded border-border text-primary focus:ring-ring"
              />

              <div>
                <label for="consent" class="text-sm text-text-muted"
                  >{t.common.consentText}
                  <a
                    href={`/${locale}/privacy`}
                    class="text-primary hover:underline"
                  >
                    {t.privacy.title}
                  </a>
                </label>

                <p id="consent-error" class="mt-2 hidden text-sm text-red-600">
                  {t.common.consentError}
                </p>
              </div>
            </div>
          </fieldset>

          <div
            class="flex items-center justify-between border-t border-border pt-6"
          >
            <button
              type="button"
              id="prev-btn"
              class="inline-flex hidden h-11 items-center justify-center rounded-md border border-border bg-surface px-5 text-sm font-semibold text-text shadow-sm transition hover:bg-surface-muted focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
            >
              {t.common.back}
            </button>

            <div class="ml-auto flex items-center gap-3">
              <button
                type="button"
                id="toggle-contact-only"
                class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-surface px-5 text-sm font-semibold text-text shadow-sm transition hover:bg-surface-muted focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
              >
                {t.contact.buttons.askQuestion}
              </button>

              <button
                type="button"
                id="next-btn"
                class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-5 text-sm font-semibold text-white shadow-md transition hover:bg-primary-light focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
              >
                {t.common.next}
              </button>

              <button
                type="submit"
                id="submit-btn"
                class="inline-flex hidden h-11 items-center justify-center rounded-md bg-primary px-5 text-sm font-semibold text-white shadow-md transition hover:bg-primary-light focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
              >
                {t.common.submit}
              </button>

              <div id="turnstile-container" class="hidden pt-2"></div>
            </div>
          </div>
        </form>

        <form
          id="contact-only-form"
          class="hidden space-y-6 px-6 py-8"
          novalidate
        >
          <input
            type="hidden"
            name="website"
            id="contact-website"
            tabindex="-1"
            autocomplete="off"
            style="display:none"
          />
          <input
            type="hidden"
            name="formLoadedAt"
            id="contact-formLoadedAt"
            value=""
          />
          <input
            type="hidden"
            name="turnstileToken"
            id="contact-turnstileToken"
            value=""
          />
          <div
            id="contact-form-error"
            class="hidden rounded-md border border-red-200 bg-red-50 p-4"
          >
            <p class="text-sm font-semibold text-red-800">
              {t.common.errorTitle}
            </p>
            <ul
              id="contact-form-error-list"
              class="mt-2 list-inside list-disc text-sm text-red-700"
            >
            </ul>
          </div>

          <div>
            <label for="contactName" class="block text-sm font-medium text-text"
              >{t.contact.contactOnly.name}
              <span class="text-red-500">*</span></label
            >

            <input
              id="contactName"
              name="contactName"
              type="text"
              required
              class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
              placeholder={t.contact.contactOnly.namePlaceholder}
            />
          </div>

          <div>
            <label
              for="contactEmail"
              class="block text-sm font-medium text-text"
              >{t.contact.contactOnly.email}
              <span class="text-red-500">*</span></label
            >

            <input
              id="contactEmail"
              name="contactEmail"
              type="email"
              required
              class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
              placeholder={t.contact.contactOnly.emailPlaceholder}
            />

            <p
              id="contact-email-error"
              class="mt-2 hidden text-sm text-red-600"
            >
              {t.common.emailError}
            </p>
          </div>
          <div>
            <label
              for="contactMessage"
              class="block text-sm font-medium text-text"
              >{t.contact.contactOnly.message}
              <span class="text-red-500">*</span></label
            >

            <textarea
              id="contactMessage"
              name="contactMessage"
              rows="4"
              required
              class="mt-1 block w-full rounded-md border border-border bg-surface px-3 py-2 text-sm text-text shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring"
              placeholder={t.contact.contactOnly.messagePlaceholder}></textarea>
          </div>

          <div
            class="flex items-center justify-between border-t border-border pt-6"
          >
            <button
              type="button"
              id="back-to-project-request"
              class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-surface px-5 text-sm font-semibold text-text shadow-sm transition hover:bg-surface-muted focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
            >
              {t.contact.contactOnly.backToProject}
            </button>

            <button
              type="button"
              id="send-contact-btn"
              class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-5 text-sm font-semibold text-white shadow-md transition hover:bg-primary-light focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
            >
              {t.contact.buttons.sendMessage}
            </button>
            <div id="contact-turnstile-container" class="hidden pt-2"></div>
          </div>
        </form>

        <div id="form-success" class="hidden px-6 py-12 text-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="mx-auto h-12 w-12 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 13l4 4L19 7"></path>
          </svg>

          <h3 class="mt-4 text-xl font-semibold text-text">
            {t.common.successTitle}
          </h3>

          <p class="mt-2 text-base text-text-muted">
            {t.common.successMessage}
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ turnstileSiteKey }}>
  window.__TURNSTILE_SITE_KEY__ = `${turnstileSiteKey}`;
</script>

<script is:inline define:vars={{ translationsJson }}>
  const form = document.getElementById('project-request-form');

  const contactForm = document.getElementById('contact-only-form');

  const success = document.getElementById('form-success');

  const prevBtn = document.getElementById('prev-btn');

  const nextBtn = document.getElementById('next-btn');

  const submitBtn = document.getElementById('submit-btn');

  const toggleContactOnly = document.getElementById('toggle-contact-only');

  const backToProjectRequest = document.getElementById(
    'back-to-project-request'
  );

  const stepIndicator = document.getElementById('step-indicator');

  const progressBar = document.getElementById('progress-bar');

  const contactOnlyPath = document.getElementById('contact-only-path');

  const sendContactBtn = document.getElementById('send-contact-btn');

  const steps = Array.from(form.querySelectorAll('.step'));

  let currentStep = 0;

  const totalSteps = steps.length;

  document.getElementById('formLoadedAt').value = new Date().toISOString();
  document.getElementById('contact-formLoadedAt').value =
    new Date().toISOString();

  const turnstileSiteKey = window.__TURNSTILE_SITE_KEY__ || '';
  let mainTurnstileWidgetId = null;
  let contactTurnstileWidgetId = null;

  // @ts-ignore
  const translationsObj = JSON.parse(translationsJson || '{}');
  const options = translationsObj.contact.options;

  const reviewLabels = {
    fullName: translationsObj.contact.review.fullName,
    email: translationsObj.contact.review.email,
    phone: translationsObj.contact.review.phone,
    company: translationsObj.contact.review.company,
    region: translationsObj.contact.review.region,
    projectType: translationsObj.contact.review.projectType,
    title: translationsObj.contact.review.title,
    idea: translationsObj.contact.review.idea,
    targetUsers: translationsObj.contact.review.targetUsers,
    problem: translationsObj.contact.review.problem,
    outcome: translationsObj.contact.review.outcome,
    features: translationsObj.contact.review.features,
    technicalNeeds: translationsObj.contact.review.technicalNeeds,
    timeline: translationsObj.contact.review.timeline,
    budget: translationsObj.contact.review.budget,
    projectStatus: translationsObj.contact.review.projectStatus,
    domain: translationsObj.contact.review.domain,
    url: translationsObj.contact.review.url,
    repo: translationsObj.contact.review.repo,
    brandAssets: translationsObj.contact.review.brandAssets,
    integrations: translationsObj.contact.review.integrations,
  };

  const idToLabel = (optionType, id) => {
    const arr = options[optionType];
    if (!arr) return id;
    const found = arr.find((item) => item.id === id);
    return found ? found.label : id;
  };

  const idsToLabels = (optionType, ids) =>
    ids.map((id) => idToLabel(optionType, id));

  const stepTextTemplate = (step, total) => `Step ${step} of ${total}`;

  const updateStep = (index) => {
    steps.forEach((step, idx) => {
      if (idx === index) {
        step.classList.remove('hidden');
      } else {
        step.classList.add('hidden');
      }
    });

    currentStep = index;

    const stepText = stepTextTemplate(index + 1, totalSteps);
    stepIndicator.textContent = stepText;

    progressBar.style.width = `${((index + 1) / totalSteps) * 100}%`;

    prevBtn.classList.toggle('hidden', index === 0);

    if (index === totalSteps - 1) {
      nextBtn.classList.add('hidden');

      submitBtn.classList.remove('hidden');

      if (turnstileSiteKey && typeof turnstile !== 'undefined') {
        const container = document.getElementById('turnstile-container');
        if (container && !container.hasChildNodes() && !mainTurnstileWidgetId) {
          mainTurnstileWidgetId = turnstile.render(container, {
            sitekey: turnstileSiteKey,
            callback: (token) => {
              document.getElementById('turnstileToken').value = token;
            },
          });
        }
      }

      renderReview();
    } else {
      nextBtn.classList.remove('hidden');

      submitBtn.classList.add('hidden');
    }
  };

  const renderReview = () => {
    const formData = new FormData(form);

    const toArr = (name) => formData.getAll(name);

    const toVal = (name) => formData.get(name);

    const setRow = (dl, label, value) => {
      const dt = document.createElement('dt');

      dt.className = 'text-xs text-text-muted';

      dt.textContent = label;

      const dd = document.createElement('dd');

      dd.className = 'text-sm text-text break-words whitespace-normal';

      dd.textContent = value;

      dl.appendChild(dt);

      dl.appendChild(dd);
    };

    const contactDl = document.querySelector(
      '#review-summary > div:nth-child(1) dl'
    );

    const projectDl = document.querySelector(
      '#review-summary > div:nth-child(2) dl'
    );

    const ideaDl = document.querySelector(
      '#review-summary > div:nth-child(3) dl'
    );

    const needsDl = document.querySelector(
      '#review-summary > div:nth-child(4) dl'
    );

    const integrationDl = document.querySelector(
      '#review-summary > div:nth-child(5) dl'
    );

    [contactDl, projectDl, ideaDl, needsDl, integrationDl].forEach((dl) => {
      if (!dl) return;

      while (dl.firstChild) dl.removeChild(dl.firstChild);
    });

    if (contactDl) {
      setRow(contactDl, reviewLabels.fullName, toVal('fullName'));

      setRow(contactDl, reviewLabels.email, toVal('email'));

      if (toVal('phone')) setRow(contactDl, reviewLabels.phone, toVal('phone'));

      if (toVal('company'))
        setRow(contactDl, reviewLabels.company, toVal('company'));

      if (toVal('region'))
        setRow(contactDl, reviewLabels.region, toVal('region'));
    }

    if (projectDl) {
      setRow(
        projectDl,
        reviewLabels.projectType,
        idToLabel('projectTypes', toVal('projectType'))
      );

      setRow(projectDl, reviewLabels.title, toVal('projectTitle'));
    }

    if (ideaDl) {
      setRow(ideaDl, reviewLabels.idea, toVal('ideaDescription'));

      if (toVal('targetUsers'))
        setRow(ideaDl, reviewLabels.targetUsers, toVal('targetUsers'));

      if (toVal('problemToSolve'))
        setRow(ideaDl, reviewLabels.problem, toVal('problemToSolve'));

      if (toVal('desiredOutcome'))
        setRow(ideaDl, reviewLabels.outcome, toVal('desiredOutcome'));
    }

    if (needsDl) {
      const features = idsToLabels('featureOptions', toArr('features')).join(
        ', '
      );

      if (features) setRow(needsDl, reviewLabels.features, features);

      const techs = idsToLabels('technicalNeeds', toArr('technicalNeeds')).join(
        ', '
      );

      if (techs) setRow(needsDl, reviewLabels.technicalNeeds, techs);

      setRow(
        needsDl,
        reviewLabels.timeline,
        idToLabel('timelineOptions', toVal('timeline'))
      );

      setRow(
        needsDl,
        reviewLabels.budget,
        idToLabel('budgetOptions', toVal('budgetRange'))
      );

      setRow(
        needsDl,
        reviewLabels.projectStatus,
        idToLabel('statusOptions', toVal('projectStatus'))
      );
    }

    if (integrationDl) {
      if (toVal('existingDomain'))
        setRow(integrationDl, reviewLabels.domain, toVal('existingDomain'));

      if (toVal('existingUrl'))
        setRow(integrationDl, reviewLabels.url, toVal('existingUrl'));

      if (toVal('existingRepo'))
        setRow(integrationDl, reviewLabels.repo, toVal('existingRepo'));

      if (toVal('existingBrandAssets'))
        setRow(
          integrationDl,
          reviewLabels.brandAssets,
          toVal('existingBrandAssets')
        );

      const integrations = idsToLabels(
        'integrationOptions',
        toArr('integrations')
      ).join(', ');

      if (integrations)
        setRow(integrationDl, reviewLabels.integrations, integrations);
    }
  };

  const showFieldErrors = (formEl, fields) => {
    const errorContainer = document.getElementById('form-error');
    const errorList = document.getElementById('form-error-list');
    if (errorContainer && errorList && fields) {
      errorList.innerHTML = '';
      Object.entries(fields).forEach(([field, message]) => {
        const li = document.createElement('li');
        li.textContent = message;
        errorList.appendChild(li);
        const input = formEl.querySelector(`[name="${field}"]`);
        if (input) input.classList.add('border-red-400');
      });
      errorContainer.classList.remove('hidden');
    }
  };

  const clearFieldErrors = (formEl) => {
    const errorContainer = document.getElementById('form-error');
    const errorList = document.getElementById('form-error-list');
    if (errorContainer) errorContainer.classList.add('hidden');
    if (errorList) errorList.innerHTML = '';
    formEl
      .querySelectorAll('.border-red-400')
      .forEach((el) => el.classList.remove('border-red-400'));
  };

  const CONTACT_FIELD_NAME_MAP = {
    fullName: 'contactName',
    email: 'contactEmail',
  };

  const mapFieldName = (field) => CONTACT_FIELD_NAME_MAP[field] || field;

  const showContactErrors = (fields) => {
    const errorContainer = document.getElementById('contact-form-error');
    const errorList = document.getElementById('contact-form-error-list');
    if (errorContainer && errorList && fields) {
      errorList.innerHTML = '';
      Object.entries(fields).forEach(([field, message]) => {
        const li = document.createElement('li');
        li.textContent = message;
        errorList.appendChild(li);
        const input = contactForm.querySelector(
          `[name="${mapFieldName(field)}"]`
        );
        if (input) input.classList.add('border-red-400');
      });
      errorContainer.classList.remove('hidden');
    }
  };

  const clearContactErrors = () => {
    const errorContainer = document.getElementById('contact-form-error');
    const errorList = document.getElementById('contact-form-error-list');
    if (errorContainer) errorContainer.classList.add('hidden');
    if (errorList) errorList.innerHTML = '';
    contactForm
      .querySelectorAll('.border-red-400')
      .forEach((el) => el.classList.remove('border-red-400'));
  };

  const validateStep = (index) => {
    const step = steps[index];

    const required = step.querySelectorAll('[required]');

    let valid = true;

    required.forEach((field) => {
      const value = field.value.trim();

      if (!value) {
        valid = false;

        field.classList.add('border-red-400');
      } else if (
        field.type === 'email' &&
        !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(field.value.trim())
      ) {
        valid = false;

        field.classList.add('border-red-400');
      } else {
        field.classList.remove('border-red-400');
      }
    });

    if (index === 2) {
      const idea = form.querySelector('#ideaDescription');

      if (idea && idea.value.trim().length < 80) {
        valid = false;

        idea.classList.add('border-red-400');
      }
    }

    return valid;
  };

  nextBtn.addEventListener('click', () => {
    if (validateStep(currentStep)) {
      updateStep(currentStep + 1);
    }
  });

  prevBtn.addEventListener('click', () => {
    if (currentStep > 0) {
      updateStep(currentStep - 1);
    }
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearFieldErrors(form);
    if (!validateStep(currentStep)) return;
    try {
      const response = await fetch('/api/submit-lead', {
        method: 'POST',
        body: new FormData(form),
      });
      const result = await response.json();
      if (!response.ok) {
        if (result.fields) showFieldErrors(form, result.fields);
        throw new Error(result.error || 'Submission failed');
      }
      form.classList.add('hidden');
      contactOnlyPath.classList.add('hidden');
      success.classList.remove('hidden');
    } catch (err) {
      alert(err.message || 'Something went wrong. Please try again.');
    } finally {
      submitBtn.disabled = false;
      nextBtn.disabled = false;
      prevBtn.disabled = false;
    }
  });

  toggleContactOnly.addEventListener('click', () => {
    form.classList.add('hidden');
    contactOnlyPath.classList.add('hidden');
    contactForm.classList.remove('hidden');
    if (success) success.classList.add('hidden');

    if (turnstileSiteKey && typeof turnstile !== 'undefined') {
      const container = document.getElementById('contact-turnstile-container');
      if (
        container &&
        !container.hasChildNodes() &&
        !contactTurnstileWidgetId
      ) {
        contactTurnstileWidgetId = turnstile.render(container, {
          sitekey: turnstileSiteKey,
          callback: (token) => {
            document.getElementById('contact-turnstileToken').value = token;
          },
        });
      }
    }
  });

  backToProjectRequest.addEventListener('click', () => {
    contactForm.classList.add('hidden');
    form.classList.remove('hidden');
  });

  sendContactBtn.addEventListener('click', async () => {
    clearContactErrors();
    const name = contactForm.querySelector('#contactName').value.trim();
    const email = contactForm.querySelector('#contactEmail').value.trim();
    const message = contactForm.querySelector('#contactMessage').value.trim();
    const contactEmailField = contactForm.querySelector('#contactEmail');
    const contactEmailError = document.getElementById('contact-email-error');
    const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    if (!name || !email || !emailValid || !message || message.length < 10) {
      if (contactEmailField && !emailValid) {
        contactEmailField.classList.add('border-red-400');
        if (contactEmailError) contactEmailError.classList.remove('hidden');
      }
      if (message && message.length < 10) {
        alert(translationsObj.common.messageMinLength);
      } else if (!message) {
        alert(translationsObj.common.contactRequired);
      }
      return;
    }
    if (contactEmailField) contactEmailField.classList.remove('border-red-400');
    if (contactEmailError) contactEmailError.classList.add('hidden');
    sendContactBtn.disabled = true;
    try {
      const formData = new FormData();
      formData.append('fullName', name);
      formData.append('email', email);
      formData.append('contactMessage', message);
      formData.append('consent', 'on');
      const websiteField = contactForm.querySelector('#contact-website');
      const formLoadedAtField = contactForm.querySelector(
        '#contact-formLoadedAt'
      );
      const turnstileTokenField = contactForm.querySelector(
        '#contact-turnstileToken'
      );
      formData.append('website', websiteField ? websiteField.value : '');
      formData.append(
        'formLoadedAt',
        formLoadedAtField ? formLoadedAtField.value : ''
      );
      formData.append(
        'turnstileToken',
        turnstileTokenField ? turnstileTokenField.value : ''
      );
      const response = await fetch('/api/submit-lead', {
        method: 'POST',
        body: formData,
      });
      const result = await response.json();
      if (!response.ok) {
        if (result.fields) showContactErrors(result.fields);
        throw new Error(result.error || 'Submission failed');
      }
      contactForm.classList.add('hidden');
      if (success) success.classList.remove('hidden');
    } catch (err) {
      alert(err.message || 'Something went wrong. Please try again.');
    } finally {
      sendContactBtn.disabled = false;
    }
  });

  updateStep(0);
</script>
