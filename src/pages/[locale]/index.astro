---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import CtaSection from '../../components/CtaSection.astro';
import { getTranslations, getAvailableLanguages } from '../../i18n';

export const getStaticPaths = () => {
  return getAvailableLanguages().map((locale) => ({ params: { locale } }));
};

const locale = Astro.params.locale || 'en';
const t = getTranslations(locale);

const services = [
  {
    title: 'Idea Structuring',
    description:
      'Turn an early idea into a clear, buildable project plan with features and priorities.',
  },
  {
    title: 'Websites',
    description:
      'Professional company and landing pages that explain the offer clearly and convert visitors.',
  },
  {
    title: 'Platforms',
    description:
      'SaaS-style apps, customer portals, dashboards, and internal tools.',
  },
  {
    title: 'Frontend',
    description:
      'Clean, usable interfaces with responsive layout, forms, and product flows.',
  },
  {
    title: 'Backend',
    description:
      'Data, accounts, admin logic, APIs, and business rules behind the product.',
  },
  {
    title: 'Payments',
    description:
      'Checkout, payment flows, subscriptions, and paid access logic.',
  },
  {
    title: 'AI Workflows',
    description:
      'Use AI to accelerate planning, development, and useful product features where they genuinely help.',
  },
  {
    title: 'Launch',
    description:
      'Deploy, connect domains, verify production, and support future improvements.',
  },
];

const processSteps = [
  {
    title: 'Submit Your Idea',
    description:
      'Start with a guided project form describing the type of solution, features, timeline, and budget.',
  },
  {
    title: 'Shape The Scope',
    description:
      'Eventnexus reviews the request and turns the idea into a practical build plan.',
  },
  {
    title: 'Build The Product',
    description:
      'The frontend, backend, database, payments, and admin tools are built as needed.',
  },
  {
    title: 'Launch And Improve',
    description:
      'The product is deployed, connected to the right domain, and improved through iterations.',
  },
];
---

<BaseLayout
  title={t.home.hero.headline}
  description={t.home.hero.supporting1}
  locale={locale}
>
  <!-- Hero -->
  <section class="bg-surface py-16 text-text md:py-24">
    <div class="container mx-auto max-w-7xl px-6">
      <div class="max-w-3xl">
        <h1
          class="text-4xl font-extrabold leading-tight tracking-tight text-text md:text-6xl"
        >
          {t.home.hero.headline}
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-text-muted md:text-xl">
          {t.home.hero.supporting1}
        </p>
        <p class="mt-4 text-lg leading-relaxed text-text-muted md:text-xl">
          {t.home.hero.supporting2}
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a
            href={`/${locale}/contact`}
            class="inline-flex h-12 items-center justify-center rounded-md bg-primary px-8 text-base font-semibold text-white shadow-md transition-colors hover:bg-primary-light focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
          >
            {t.home.hero.primaryCta}
          </a>
          <a
            href={`/${locale}/#services`}
            class="inline-flex h-12 items-center justify-center rounded-md border border-border bg-surface px-8 text-base font-semibold text-text shadow-sm transition-colors hover:bg-surface-muted focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
          >
            {t.home.hero.secondaryCta}
          </a>
        </div>
        <p class="mt-8 text-sm text-text-muted">
          {t.home.hero.trustLine}
        </p>
      </div>
    </div>
  </section>

  <!-- Problem -->
  <Section
    eyebrow={t.home.problem.eyebrow}
    title={t.home.problem.headline}
    description={t.home.problem.description}
    className="bg-surface-muted"
  />

  <!-- Services -->
  <Section
    id="services"
    eyebrow={t.home.services.eyebrow}
    title={t.home.services.headline}
    description={t.home.services.description}
  >
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <article class="rounded-lg border border-border bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <h3 class="text-lg font-semibold text-text">{service.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-text-muted">
              {service.description}
            </p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- Process -->
  <Section
    id="process"
    eyebrow={t.home.process.eyebrow}
    title={t.home.process.headline}
    className="bg-surface-muted"
  >
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        processSteps.map((step, index) => (
          <div class="relative flex flex-col items-start">
            <span class="text-sm font-bold uppercase tracking-widest text-primary">
              {t.common.stepOf(index + 1, processSteps.length)}
            </span>
            <h3 class="mt-3 text-xl font-semibold text-text">{step.title}</h3>
            <p class="mt-2 text-base leading-relaxed text-text-muted">
              {step.description}
            </p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Proof -->
  <Section
    id="work"
    eyebrow={t.home.proof.eyebrow}
    title={t.home.proof.headline}
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div
        class="rounded-lg border border-border bg-surface-muted p-6 shadow-sm"
      >
        <span
          class="text-xs font-semibold uppercase tracking-widest text-primary"
          >Web Platform</span
        >
        <h3 class="mt-3 text-lg font-semibold text-text">Rootwise</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">
          {t.home.proof.description}
        </p>
        <a
          href="https://rootwise.site"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center text-sm font-semibold text-primary transition-colors hover:text-primary-light"
        >
          Visit rootwise.site
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="ml-1 h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            ></path>
          </svg>
        </a>
      </div>
      <div
        class="rounded-lg border border-border bg-surface-muted p-6 shadow-sm"
      >
        <span
          class="text-xs font-semibold uppercase tracking-widest text-primary"
          >AI Tool</span
        >
        <h3 class="mt-3 text-lg font-semibold text-text">LeadScout Pro AI</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">
          AI-assisted lead generation and business-development tooling.
        </p>
        <a
          href="https://github.com/pikkst/LeadScout-Pro-AI"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center text-sm font-semibold text-primary transition-colors hover:text-primary-light"
        >
          View on GitHub
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="ml-1 h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            ></path>
          </svg>
        </a>
      </div>
      <div
        class="rounded-lg border border-border bg-surface-muted p-6 shadow-sm"
      >
        <span
          class="text-xs font-semibold uppercase tracking-widest text-primary"
          >Data AI</span
        >
        <h3 class="mt-3 text-lg font-semibold text-text">AetherForecast AI</h3>
        <p class="mt-2 text-sm leading-relaxed text-text-muted">
          Data-focused AI experimentation with dashboards, forecasting, and
          decision tools.
        </p>
        <a
          href="https://github.com/pikkst/AetherForecast-AI"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center text-sm font-semibold text-primary transition-colors hover:text-primary-light"
        >
          View on GitHub
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="ml-1 h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            ></path>
          </svg>
        </a>
      </div>
    </div>
    <div class="mt-4">
      <a
        href={`/${locale}/work`}
        class="inline-flex h-12 items-center justify-center rounded-md border border-border bg-surface px-8 text-base font-semibold text-text shadow-sm transition-colors hover:bg-surface-muted focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
      >
        View all work
      </a>
    </div>
  </Section>

  <!-- Intake CTA -->
  <CtaSection
    heading={t.home.intakeCta.heading}
    body={t.home.intakeCta.body}
    primaryCta={{ label: t.home.intakeCta.primaryCta, href: `/${locale}/contact` }}
  />
</BaseLayout>
