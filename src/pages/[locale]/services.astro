---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import CtaSection from '../../components/CtaSection.astro';
import { getTranslations, getAvailableLanguages } from '../../i18n';

export const getStaticPaths = () => {
  return getAvailableLanguages().map((locale) => ({ params: { locale } }));
};

const locale = Astro.params.locale || 'en';
const t = getTranslations(locale);

const services = t.services.serviceCards;

const projectTypes = [
  'SaaS platforms',
  'customer portals',
  'service booking platforms',
  'company websites',
  'lead-generation websites',
  'internal business tools',
  'admin dashboards',
  'payment-enabled service platforms',
  'AI-assisted workflow tools',
  'automation systems',
  'data and reporting dashboards',
];
---

<BaseLayout
  title={t.services.hero.headline}
  description={t.services.hero.description1}
  locale={locale}
>
  <!-- Hero -->
  <section class="bg-surface py-16 text-text md:py-24">
    <div class="container mx-auto max-w-7xl px-6">
      <div class="max-w-3xl">
        <h1
          class="text-4xl font-extrabold leading-tight tracking-tight text-text md:text-6xl"
        >
          {t.services.hero.headline}
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-text-muted md:text-xl">
          {t.services.hero.description1}
        </p>
        <p class="mt-4 text-lg leading-relaxed text-text-muted md:text-xl">
          {t.services.hero.description2}
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a
            href={`/${locale}/contact`}
            class="inline-flex h-12 items-center justify-center rounded-md bg-primary px-8 text-base font-semibold text-white shadow-md transition-colors hover:bg-primary-light focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
          >
            {t.services.hero.primaryCta}
          </a>
          <a
            href={`/${locale}/#turnkey`}
            class="inline-flex h-12 items-center justify-center rounded-md border border-border bg-surface px-8 text-base font-semibold text-text shadow-sm transition-colors hover:bg-surface-muted focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
          >
            {t.services.hero.secondaryCta}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Promise -->
  <Section
    id="services"
    eyebrow={t.services.promise.eyebrow}
    title={t.services.promise.headline}
    description={t.services.promise.description}
  >
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <article class="rounded-lg border border-border bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
            <h3 class="text-lg font-semibold text-text">{service.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-text-muted">
              {service.description}
            </p>
            <div class="mt-4">
              <p class="text-sm font-semibold uppercase tracking-widest text-slate-500">
                {t.ui.includes}
              </p>
              <ul class="mt-2 space-y-1">
                {service.includes.map((item, idx) => (
                  <li key={idx} class="text-sm text-text-muted">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
            <div class="mt-4 border-t border-border pt-4">
              <p class="text-sm font-semibold uppercase tracking-widest text-slate-500">
                {t.ui.bestFor}
              </p>
              <p class="mt-2 text-sm leading-relaxed text-text-muted">
                {service.bestFor}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- Turnkey -->
  <Section
    id="turnkey"
    eyebrow={t.services.turnkey.eyebrow}
    title={t.services.turnkey.headline}
    className="bg-surface-muted"
  >
    <div class="max-w-3xl space-y-4 text-base leading-relaxed text-text-muted">
      <p>
        {t.services.turnkey.description1}
      </p>
      <p>
        {t.services.turnkey.description2}
      </p>
      <p class="font-semibold text-text">{t.services.turnkey.suitableLabel}</p>
      <ul class="grid gap-2 pt-2 sm:grid-cols-2">
        {
          projectTypes.map((type, idx) => (
            <li key={idx} class="flex items-start gap-2 text-sm">
              <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-primary" />
              <span>{type}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- How To Start -->
  <Section
    id="how-to-start"
    eyebrow={t.services.howToStart.eyebrow}
    title={t.services.howToStart.headline}
  >
    <div class="max-w-3xl space-y-4 text-base leading-relaxed text-text-muted">
      <p>
        {t.services.howToStart.description1}
      </p>
      <p>
        {t.services.howToStart.description2}
      </p>
    </div>
    <div class="mt-8">
      <a
        href={`/${locale}/contact`}
        class="inline-flex h-12 items-center justify-center rounded-md bg-primary px-8 text-base font-semibold text-white shadow-md transition-colors hover:bg-primary-light focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
      >
        {t.services.howToStart.cta}
      </a>
    </div>
  </Section>

  <!-- Intake CTA -->
  <CtaSection
    heading={t.services.intakeCta.heading}
    body={t.services.intakeCta.body}
    primaryCta={{ label: t.services.intakeCta.primaryCta, href: `/${locale}/contact` }}
  />
</BaseLayout>
