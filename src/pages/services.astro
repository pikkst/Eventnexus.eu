---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import CtaSection from '../components/CtaSection.astro';
import { getTranslations, getLanguageFromPath } from '../i18n';

const locale = getLanguageFromPath(Astro.url.pathname);
const t = getTranslations(locale);
---

<BaseLayout title={t.services.hero.headline} description={t.services.hero.description1} locale={locale}>
  <section class="bg-surface py-16 text-text md:py-24">
    <div class="container mx-auto max-w-7xl px-6">
      <div class="max-w-3xl">
        <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-text md:text-6xl">
          {t.services.hero.headline}
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-text-muted md:text-xl">
          {t.services.hero.description1}
        </p>
        <p class="mt-4 text-lg leading-relaxed text-text-muted md:text-xl">
          {t.services.hero.description2}
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a href={`/${locale}/contact`} class="inline-flex h-12 items-center justify-center rounded-md bg-primary px-8 text-base font-semibold text-white shadow-md transition-colors hover:bg-primary-light focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2">
            {t.services.hero.primaryCta}
          </a>
          <a href={`/${locale}/#turnkey`} class="inline-flex h-12 items-center justify-center rounded-md border border-border bg-surface px-8 text-base font-semibold text-text shadow-sm transition-colors hover:bg-surface-muted focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2">
            {t.services.hero.secondaryCta}
          </a>
        </div>
      </div>
    </div>
  </section>

  <Section id="services" eyebrow={t.services.promise.eyebrow} title={t.services.promise.headline} description={t.services.promise.description}>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <article class="rounded-lg border border-border bg-surface p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-text">{t.services.serviceCards[0].title}</h3>
        <p class="mt-3 text-base leading-relaxed text-text-muted">{t.services.serviceCards[0].description}</p>
      </article>
      <article class="rounded-lg border border-border bg-surface p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-text">{t.services.serviceCards[1].title}</h3>
        <p class="mt-3 text-base leading-relaxed text-text-muted">{t.services.serviceCards[1].description}</p>
      </article>
      <article class="rounded-lg border border-border bg-surface p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-text">{t.services.serviceCards[2].title}</h3>
        <p class="mt-3 text-base leading-relaxed text-text-muted">{t.services.serviceCards[2].description}</p>
      </article>
    </div>
  </Section>

  <Section id="turnkey" eyebrow={t.services.turnkey.eyebrow} title={t.services.turnkey.headline} className="bg-surface-muted">
    <p class="max-w-3xl text-base leading-relaxed text-text-muted">{t.services.turnkey.description1}</p>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-text-muted">{t.services.turnkey.description2}</p>
  </Section>

  <CtaSection heading={t.services.intakeCta.heading} body={t.services.intakeCta.body} primaryCta={{ label: t.services.intakeCta.primaryCta, href: `/${locale}/contact` }} />
</BaseLayout>
