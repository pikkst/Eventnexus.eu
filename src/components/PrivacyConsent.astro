---
import { getTranslations, type Language } from '../i18n';

const { locale = 'en', privacyUrl = '/privacy' } = Astro.props;
const t = getTranslations(locale as Language);
const analyticsId = import.meta.env.PUBLIC_ANALYTICS_ID;
const analyticsEnabled = import.meta.env.PUBLIC_ANALYTICS_ENABLED !== 'false';
const shouldLoad = typeof analyticsId === 'string' && analyticsId.trim() !== '' && analyticsEnabled;
---

<div id="privacy-consent-banner" class="hidden fixed bottom-0 inset-x-0 bg-slate-900 text-white z-50"
  data-analytics-id={analyticsId || ''}
  data-analytics-enabled={shouldLoad ? 'true' : 'false'}>
  <div class="container mx-auto max-w-6xl flex flex-col sm:flex-row items-center justify-between gap-4 px-4 py-4">
    <p class="text-sm text-slate-200">
      {t.privacy.analyticsText}
      <a href={privacyUrl} class="underline hover:text-white ml-1">{t.privacy.title}</a>
    </p>
    <div class="flex gap-3 shrink-0">
      <button
        id="privacy-accept"
        class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-5 text-sm font-semibold text-white shadow-md transition hover:bg-primary-light focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
      >
        {t.privacy.accept}
      </button>
      <button
        id="privacy-decline"
        class="inline-flex h-10 items-center justify-center rounded-md border border-slate-600 bg-slate-800 px-5 text-sm font-semibold text-slate-200 shadow-sm transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
      >
        {t.privacy.decline}
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    const consent = localStorage.getItem('analytics-consent');
    const banner = document.getElementById('privacy-consent-banner');
    if (!banner) return;

    if (consent === 'granted' || consent === 'denied') {
      banner.classList.add('hidden');
      return;
    }

    banner.classList.remove('hidden');

    const emitConsentChange = () => {
      window.dispatchEvent(new Event('analytics-consent-changed'));
    };

    document
      .getElementById('privacy-accept')
      ?.addEventListener('click', () => {
        localStorage.setItem('analytics-consent', 'granted');
        banner.classList.add('hidden');
        emitConsentChange();
      });

    document
      .getElementById('privacy-decline')
      ?.addEventListener('click', () => {
        localStorage.setItem('analytics-consent', 'denied');
        banner.classList.add('hidden');
        emitConsentChange();
      });
  })();
</script>
