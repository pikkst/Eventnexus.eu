---
const navItems = [
  { label: 'Services', href: '/services' },
  { label: 'Process', href: '/#process' },
  { label: 'Work', href: '/#work' },
  { label: 'Start a Project', href: '/contact' },
];
---
<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur">
  <div class="mx-auto max-w-6xl px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-lg font-semibold tracking-tight text-slate-900">
      Eventnexus
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="transition hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 rounded"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
