---
import LanguageSwitcher from './LanguageSwitcher.astro';

const { locale = 'en' } = Astro.props;

const navItems = [
  { label: 'Services', href: `/${locale}/services` },
  { label: 'Process', href: `/${locale}/#process` },
  { label: 'Work', href: `/${locale}/work` },
  { label: 'Start a Project', href: `/${locale}/contact` },
];
---

<header
  class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href={`/${locale}`} class="text-lg font-semibold tracking-tight text-slate-900">
      Eventnexus
    </a>
    <div class="flex items-center gap-4">
      <nav
        id="nav-menu"
        class="hidden items-center gap-6 text-sm font-medium text-slate-600 md:flex"
      >
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="rounded transition hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <LanguageSwitcher locale={locale} />
    </div>
    <button
      id="nav-toggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-slate-300 text-slate-600 transition hover:border-slate-400 hover:text-slate-900 md:hidden"
      aria-expanded="false"
      aria-controls="nav-mobile"
      aria-label="Toggle navigation"
    >
      <svg
        id="nav-icon-open"
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg
        id="nav-icon-close"
        class="hidden h-5 w-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <nav
      id="nav-menu"
      class="hidden items-center gap-6 text-sm font-medium text-slate-600 md:flex"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="rounded transition hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div
    id="nav-mobile"
    class="hidden border-t border-slate-200 bg-white md:hidden"
  >
    <nav
      class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-4 text-sm font-medium text-slate-600"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="block border-b border-slate-100 py-3 transition last:border-b-0 hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobileMenu = document.getElementById('nav-mobile');
  const openIcon = document.getElementById('nav-icon-open');
  const closeIcon = document.getElementById('nav-icon-close');
  const isOpen = () => mobileMenu && !mobileMenu.classList.contains('hidden');

  const closeMenu = () => {
    if (!mobileMenu || !toggle || !openIcon || !closeIcon) return;
    mobileMenu.classList.add('hidden');
    toggle.setAttribute('aria-expanded', 'false');
    openIcon.classList.remove('hidden');
    closeIcon.classList.add('hidden');
  };

  const openMenu = () => {
    if (!mobileMenu || !toggle || !openIcon || !closeIcon) return;
    mobileMenu.classList.remove('hidden');
    toggle.setAttribute('aria-expanded', 'true');
    openIcon.classList.add('hidden');
    closeIcon.classList.remove('hidden');
  };

  if (toggle && mobileMenu) {
    toggle.addEventListener('click', () => {
      isOpen() ? closeMenu() : openMenu();
    });
  }

  const mobileLinks = mobileMenu ? mobileMenu.querySelectorAll('a') : [];
  mobileLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
