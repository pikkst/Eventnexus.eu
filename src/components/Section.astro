---
const { as: Tag = 'section', className = '', eyebrow, title, description } = Astro.props;
---
<Tag
  class="container mx-auto px-4 py-16 md:py-24"
>
  {(eyebrow || title || description) && (
    <div class="mb-12 max-w-3xl">
      {eyebrow && (
        <p class="text-sm font-semibold uppercase tracking-widest text-slate-500">
          {eyebrow}
        </p>
      )}
      {title && (
        <h2 class="mt-3 text-2xl md:text-3xl font-semibold tracking-tight text-slate-900">
          {title}
        </h2>
      )}
      {description && (
        <p class="mt-4 text-base text-slate-600">{description}</p>
      )}
    </div>
  )}
  <slot />
</Tag>
