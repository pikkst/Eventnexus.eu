---
const analyticsId = import.meta.env.PUBLIC_ANALYTICS_ID;
const analyticsEnabled = import.meta.env.PUBLIC_ANALYTICS_ENABLED !== 'false';
const isValidAnalyticsId = typeof analyticsId === 'string' && /^G-[A-Z0-9]{10}$/i.test(analyticsId);
const shouldLoadAnalytics = isValidAnalyticsId && analyticsEnabled;
---

{
  shouldLoadAnalytics && (
    <>
      <meta name="ga4-id" content={analyticsId} />
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
      <script type="module" src="/analytics-init.js"></script>
    </>
  )
}
