---
const { id, heading, body, primaryCta, secondaryCta } = Astro.props;
---

<section id={id} class="bg-slate-900 text-white">
  <div class="container mx-auto px-4 py-16 text-center md:py-24">
    {
      heading && (
        <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
          {heading}
        </h2>
      )
    }
    {body && <p class="mx-auto mt-4 max-w-2xl text-slate-300">{body}</p>}
    {
      (primaryCta || secondaryCta) && (
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          {primaryCta && (
            <a
              href={primaryCta.href}
              class="inline-flex h-11 items-center justify-center rounded-md bg-white px-5 text-sm font-semibold text-slate-900 transition hover:bg-slate-200"
            >
              {primaryCta.label}
            </a>
          )}
          {secondaryCta && (
            <a
              href={secondaryCta.href}
              class="inline-flex h-11 items-center justify-center rounded-md border border-slate-700 px-5 text-sm font-semibold text-white transition hover:border-white"
            >
              {secondaryCta.label}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>
