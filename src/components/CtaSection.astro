---
const { heading, body, primaryCta, secondaryCta } = Astro.props;
---
<section class="bg-slate-900 text-white">
  <div class="container mx-auto px-4 py-16 md:py-24 text-center">
    {heading && (
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">{heading}</h2>
    )}
    {body && <p class="mt-4 mx-auto max-w-2xl text-slate-300">{body}</p>}
    {(primaryCta || secondaryCta) && (
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        {primaryCta && (
          <a
            href={primaryCta.href}
            class="inline-flex h-11 items-center justify-center rounded-md bg-white px-5 text-sm font-semibold text-slate-900 transition hover:bg-slate-200"
          >
            {primaryCta.label}
          </a>
        )}
        {secondaryCta && (
          <a
            href={secondaryCta.href}
            class="inline-flex h-11 items-center justify-center rounded-md border border-slate-700 px-5 text-sm font-semibold text-white transition hover:border-white"
          >
            {secondaryCta.label}
          </a>
        )}
      </div>
    )}
  </div>
</section>
