---
const { title, description, category, href } = Astro.props;
---

<a
  href={href || '#'}
  class="group block rounded-lg border border-border bg-surface p-6 shadow-sm transition hover:shadow-md"
>
  {
    category && (
      <span class="text-xs font-semibold uppercase tracking-widest text-primary">
        {category}
      </span>
    )
  }
  <h3
    class="mt-3 text-lg font-semibold text-text transition-colors group-hover:text-primary"
  >
    {title}
  </h3>
  {
    description && (
      <p class="mt-2 text-sm leading-relaxed text-text-muted">{description}</p>
    )
  }
</a>
