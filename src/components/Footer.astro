---
import { getTranslations, type Language } from '../i18n';

const { locale = 'en' } = Astro.props;
const t = getTranslations(locale as Language);
---

<footer class="bg-slate-900 py-12 text-white">
  <div class="container mx-auto px-6 text-center text-sm">
    <p>&copy; 2026 EventNexus OÜ. All Rights Reserved.</p>
    <p>EventNexus OÜ (reg. no. 17431557), Põltsamaa, Estonia</p>
    <p class="mt-1">
      <a
        href="https://www.eventnexus.eu/"
        class="text-primary-light hover:underline">www.eventnexus.eu</a
      >
    </p>
    <p class="mt-4">
      <a
        href={`/${locale}/privacy`}
        class="text-slate-300 hover:text-white hover:underline"
      >
        {t.privacy.title}
      </a>
    </p>
    <p class="mt-2">
      <button
        id="privacy-settings-btn"
        class="text-slate-400 hover:text-white hover:underline"
        type="button"
      >
        {
          locale === 'et'
            ? 'Privaatsuse seaded'
            : locale === 'ru'
              ? 'Настройки конфиденциальности'
              : locale === 'de'
                ? 'Datenschutzeinstellungen'
                : locale === 'fi'
                  ? 'Tietosuoja-asetukset'
                  : 'Privacy settings'
        }
      </button>
    </p>
  </div>
</footer>

<script>
  (function () {
    const btn = document.getElementById('privacy-settings-btn');
    if (!btn) return;
    btn.addEventListener('click', function () {
      localStorage.removeItem('analytics-consent');
      location.reload();
    });
  })();
</script>
